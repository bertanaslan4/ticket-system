PORT=3000
HOST=127.0.0.1
# Boşsa yerel kalıcı PGlite; sunucuda PostgreSQL URL'si kullanılır.
DATABASE_URL=
DATA_DIR=./data
APP_ORIGIN=http://localhost:3000
# İlk demo verilerini oluşturmak için true. Üretimde false.
SEED_DEMO=true
NODE_ENV=development

# Private attachments: local (development) or r2. Never make the bucket public.
ATTACHMENT_STORAGE=local
ATTACHMENT_DIR=./storage
LEGACY_ATTACHMENT_DIR=./data/attachments
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Enable after these template keys are registered in the Bekatos mail API.
MAIL_ENABLED=false
MAIL_API_URL=https://api.bekatos.com/mail/send
MAIL_API_SECRET=
MAIL_API_REPLY_TO=destek@bekatos.com
MAIL_API_SOURCE=ushops
MAIL_TEMPLATE_CLOSED=
MAIL_TEMPLATE_ASSIGNED=
# Public application URL. Leave empty to omit the link on local installations.
MAIL_APP_URL=
