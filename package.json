{
  "name": "bekatos-ticket-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch-path=server --watch-path=shared scripts/dev-server.js",
    "start": "node server/index.js",
    "build": "npm run typecheck:frontend && npm run build:server && vite build",
    "test": "npm run typecheck:frontend && npm run test:backend && npm run test:frontend",
    "db:export": "node scripts/export-db.js",
    "build:server": "node scripts/build-server.js",
    "typecheck:frontend": "tsc -p tsconfig.frontend.json",
    "test:frontend": "vitest run",
    "test:backend": "npm run build:server && node --test tests/*.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@electric-sql/pglite": "^0.3.14",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@tanstack/react-query": "^5.104.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.4.0",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
